# Local development defaults. Production values live on the VPS in
# /srv/apps/portfolio/shared/.env (generated by deploy/server/bootstrap-portfolio.sh).

SECRET_KEY=change-me-local-dev-only
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# 'sqlite3' (local default) or 'postgresql'
DB_ENGINE=sqlite3

# Used when DB_ENGINE=postgresql
# DB_NAME=portfolio_db
# DB_USER=portfolio_main
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432
